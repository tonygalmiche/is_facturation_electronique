<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_saxon_test" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="(//button[@name='action_post'])[last()]"
                position="before"
            >
                <button
                    name="action_test_saxon_validation"
                    string="Tester si la facture est valide"
                    type="object"
                    data-hotkey="v"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                />
            </xpath>
        </field>
    </record>
</odoo>
